<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Icon + Final ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/notification_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/phclogo1"
                android:contentDescription="Notification Icon"
                android:background="@drawable/circle_background"
                android:padding="8dp" />

            <TextView
                android:id="@+id/detailFinalIdTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="303730"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="12dp" />

        <!-- Info Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PHC / Diary No -->
            <TextView
                android:id="@+id/detailPhcRegistrationNoTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHC Registration / Diary No"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Outlet / Complainant Name -->
            <TextView
                android:id="@+id/detailOutletNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Outlet / Complainant Name"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />



            <!-- District -->
            <TextView
                android:id="@+id/detailDistrictTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="District"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Seal Type / Complaint Detail -->
            <TextView
                android:id="@+id/SealType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seal Type / Complaint Detail"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Category / Complaint Title -->
            <TextView
                android:id="@+id/CategoryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category / Complaint Title"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Sealed By / Complainant Name -->
            <TextView
                android:id="@+id/sealedBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sealed By / Complainant Name"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Complainant Address -->
            <TextView
                android:id="@+id/detailComplainantAddressTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complainant Address"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Complainant Contact No -->
            <TextView
                android:id="@+id/detailComplainantContactNoTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact No"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Summon / Complaint Date -->
            <TextView
                android:id="@+id/SummonIssueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Summon / Complaint Date"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Additional Complaint Fields -->
            <TextView
                android:id="@+id/Comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/PHCRegistrationNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHC Registration No"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complaint Title"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/ComplaintDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complaint Detail"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/ComplainantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complainant Name"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
